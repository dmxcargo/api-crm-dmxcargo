APP_NAME="api.crm.dmxcargo.co.id"
APP_ENV=local
APP_KEY=GENERATE_WITH_ARTISAN
APP_DEBUG=false
APP_URL=http://localhost:8081
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Asia/Jakarta

POSTGRES_IMAGE=postgres:17-alpine
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ptdmx
DB_USERNAME=ptdmx
DB_PASSWORD=GENERATE_LOCALLY

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=array
LOG_CHANNEL=stderr
LOG_LEVEL=info
TOKEN_EXPIRATION_MINUTES=480
IDEMPOTENCY_TTL_HOURS=24
BCRYPT_ROUNDS=12
IMPORT_MAX_MB=20
CORS_ALLOWED_ORIGINS=http://localhost:5173
ARCHIVE_PURGE_ENABLED=false
